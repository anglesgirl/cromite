diff --git a/chrome/browser/extensions/component_extensions_loader.cc b/chrome/browser/extensions/component_extensions_loader.cc
--- a/chrome/browser/extensions/component_extensions_loader.cc
+++ b/chrome/browser/extensions/component_extensions_loader.cc
@@ -340,6 +340,15 @@ bool ComponentExtensionsLoader::LoadComponentExtensions(
 
   // ... (existing component extensions) ...
 
+  // AO3 Browser: load the bundled AO3 Translator extension
+  {
+    base::FilePath path = base::PathService::CheckedGet(
+        chrome::DIR_COMPONENT_EXTENSIVE_RESOURCES);
+    path = path.AppendASCII("ao3-translator");
+    if (base::PathExists(path)) {
+      LoadComponentExtension(path);
+    }
+  }
+
   return true;
 }
diff --git a/chrome/browser/extensions/default_extensions/BUILD.gn b/chrome/browser/extensions/default_extensions/BUILD.gn
new file mode 100644
--- /dev/null
+++ b/chrome/browser/extensions/default_extensions/BUILD.gn
@@ -0,0 +1,9 @@
+# AO3 Browser: bundle the AO3 Translator extension as a component extension
+copy("ao3_translator_extension") {
+  sources = [
+    "//chrome/browser/extensions/default_extensions/ao3-translator/manifest.json",
+    "//chrome/browser/extensions/default_extensions/ao3-translator/background.js",
+    "//chrome/browser/extensions/default_extensions/ao3-translator/gm-polyfill.js",
+    "//chrome/browser/extensions/default_extensions/ao3-translator/zh-cn.js",
+    "//chrome/browser/extensions/default_extensions/ao3-translator/ao3-chinese.user.js",
+  ]
+  outputs = [ "$root_gen_dir/extensions/ao3-translator/{{source_file_part}}" ]
+}
