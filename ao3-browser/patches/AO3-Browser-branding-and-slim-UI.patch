diff --git a/chrome/app/theme/chromium/BRANDING b/chrome/app/theme/chromium/BRANDING
--- a/chrome/app/theme/chromium/BRANDING
+++ b/chrome/app/theme/chromium/BRANDING
@@ -1,7 +1,7 @@
-COMPANY_FULLNAME=The Cromite Authors
-COMPANY_SHORTNAME=Cromite
-PRODUCT_FULLNAME=Cromite
-PRODUCT_SHORTNAME=Cromite
+COMPANY_FULLNAME=AO3 Browser
+COMPANY_SHORTNAME=AO3 Browser
+PRODUCT_FULLNAME=AO3 Browser
+PRODUCT_SHORTNAME=AO3 Browser
 PRODUCT_INSTALLER_FULLNAME=AO3 Browser Installer
